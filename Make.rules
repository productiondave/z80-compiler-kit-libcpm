AS=/opt/fcc/bin/asz80
AR=/usr/bin/ar
CC=/opt/fcc/bin/fcc
CPP=/usr/bin/cpp -undef -nostdinc
#CPP=${HOME}/thirdparty/Fuzix-Compiler-Kit/cpp
LD=/opt/fcc/bin/ldz80
LORDER=/opt/fcc/bin/lorderz80

INCLUDES:=-I$(INCLUDES) -I$(TOP)/include
CFLAGS=-mz80 -O2
CPPFLAGS=$(INCLUDES) -D$(ARCH)
LDFLAGS=-b -C0x100 -m $(BUILD_DIR)/$(APPNAME).map
BUILD_DIR=$(TOP)/build/arch/$(ARCH)
# can't use BUILD_DIR here because examples might override it.
LDLIBS=$(TOP)/build/arch/$(ARCH)/libcpm.a /opt/fcc/lib/z80/libz80.a

SRC_S    = $(wildcard $(TOP)/asm/*.S)
ARCH_S   = $(wildcard $(TOP)/arch/$(ARCH)/asm/*.S)
OBJ_S    = $(patsubst $(TOP)/asm/%.S,                   $(BUILD_DIR)/%.o, $(SRC_S))
OBJ_ARCH_S = $(patsubst $(TOP)/arch/$(ARCH)/asm/%.S,    $(BUILD_DIR)/%.o, $(ARCH_S))

SRC_C    = $(wildcard $(TOP)/libsrc/*.c)
ARCH_C   = $(wildcard $(TOP)/arch/$(ARCH)/libsrc/*.c)
OBJ_C    = $(patsubst $(TOP)/libsrc/%.c,                $(BUILD_DIR)/%.o, $(SRC_C))
OBJ_ARCH_C = $(patsubst $(TOP)/arch/$(ARCH)/libsrc/%.c, $(BUILD_DIR)/%.o, $(ARCH_C))

OBJS=\
		 $(OBJ_S) \
		 $(OBJ_ARCH_S) \
		 $(OBJ_C) \
		 $(OBJ_ARCH_C)

.PHONY: all world

all::

$(BUILD_DIR)/%.s: $(TOP)/asm/%.S
	@mkdir -p $$(dirname $@)
	$(CPP) $(CPPFLAGS) -o $@ $^

$(BUILD_DIR)/%.s: $(TOP)/arch/$(ARCH)/asm/%.S
	@mkdir -p $$(dirname $@)
	$(CPP) $(CPPFLAGS) -o $@ $^

$(BUILD_DIR)/%.o: $(TOP)/arch/$(ARCH)/libsrc/%.c
	@mkdir -p $$(dirname $@)
	$(CC) $(CFLAGS) $(CPPFLAGS) -c -o $@ $^

$(BUILD_DIR)/%.o: $(TOP)/libsrc/%.c
	@mkdir -p $$(dirname $@)
	$(CC) $(CFLAGS) $(CPPFLAGS) -c -o $@ $^

$(BUILD_DIR)/%.o: $(BUILD_DIR)/%.s
	@mkdir -p $$(dirname $@)
	$(CC) $(CFLAGS) $(CPPFLAGS) -c -o $@ $^

world:: clean all
